{
  "name": "renacred-server",
  "version": "1.0.0",
  "description": "Backend API para a plataforma Renacred - Consultas de Histórico Imobiliário e Gestão de Créditos",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "npx prisma generate",
    "prisma:push": "npx prisma db push",
    "prisma:migrate": "npx prisma migrate deploy",
    "prisma:dev": "npx prisma migrate dev",
    "seed:superadmin": "tsx src/scripts/seed-superadmin.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.4",
    "winston": "^3.11.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/ssh2": "^1.15.6",
    "prisma": "^5.22.0",
    "ssh2": "^1.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3"
  }
}
