generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  PRE_PAID
  POST_PAID
}

enum Role {
  COMPANY_ADMIN
  COMPANY_USER
  SUPER_ADMIN
}

enum TransactionType {
  RECHARGE
  QUERY_DEBIT
  MANUAL_ADJUSTMENT
  INVOICE_PAYMENT
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
  OVERDUE
}

enum QuerySource {
  WEB
  API
}

enum QueryStatus {
  COMPLETED
  ERROR
}

model Company {
  id                 String              @id @default(uuid())
  cnpjCpf            String              @unique
  razaoSocial        String
  nomeFantasia       String?
  email              String              @unique
  telefone           String?
  endereco           String?
  cidade             String?
  estado             String?
  cep                String?
  
  // Modalidade de Cobrança (Pré-pago vs Pós-pago)
  accountType        AccountType         @default(PRE_PAID)
  creditsBalance     Decimal             @default(0) @db.Decimal(10, 2)
  creditLimit        Decimal             @default(0) @db.Decimal(10, 2)
  billingDueDate     Int                 @default(10) // Dia de vencimento do mês (1 a 31)
  customQueryPrice   Decimal?            @db.Decimal(10, 2) // Se nulo, usa o valor padrão da plataforma
  
  rateLimitPerMinute Int                 @default(60)
  isActive           Boolean             @default(true)
  
  // Governança de Produtos e Tarifação Diferenciada por Assinante (B2B Multi-Produto)
  allowedProducts    String[]            @default(["ALL"])
  customPrices       Json?               // Mapa de preços customizados: { "E1": 3.50, "E4": 1.20 }

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  users              User[]
  apiKeys            ApiKey[]
  queries            Query[]
  transactions       CreditTransaction[]
  payments           Payment[]
  invoices           Invoice[]

  @@index([cnpjCpf])
  @@index([email])
  @@index([accountType])
  @@index([isActive])
  @@map("companies")
}

model User {
  id           String    @id @default(uuid())
  companyId    String
  name         String
  email        String    @unique
  password     String
  role         Role      @default(COMPANY_USER)
  isSuperAdmin Boolean   @default(false)
  isActive     Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  queries      Query[]

  @@index([email])
  @@index([companyId])
  @@index([isSuperAdmin])
  @@map("users")
}

model ApiKey {
  id           String    @id @default(uuid())
  companyId    String
  key          String    @unique
  name         String    @default("Chave de Integração API")
  allowedIps   String[]  @default([])
  allowedProducts String[] @default(["ALL"])
  rateLimitMin Int       @default(60)
  totalCalls   Int       @default(0)
  lastUsedAt   DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  logs         ApiLog[]

  @@index([key])
  @@index([companyId])
  @@map("api_keys")
}

model ApiLog {
  id             String    @id @default(uuid())
  apiKeyId       String?
  companyId      String
  endpoint       String
  method         String
  statusCode     Int
  responseTimeMs Int
  ipAddress      String?
  creditsUsed    Decimal   @default(0) @db.Decimal(10, 2)
  createdAt      DateTime  @default(now())

  apiKey         ApiKey?   @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([apiKeyId])
  @@map("api_logs")
}

model Query {
  id               String      @id @default(uuid())
  companyId        String
  userId           String?
  identifier       String      // CPF ou CNPJ pesquisado
  source           QuerySource @default(WEB)
  status           QueryStatus @default(COMPLETED)
  cost             Decimal     @default(0) @db.Decimal(10, 2)
  totalDeclaracoes Int         @default(0)
  processingTimeMs Int?
  requestData      Json?
  resultData       Json?
  errorData        Json?
  createdAt        DateTime    @default(now())

  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user             User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([identifier])
  @@index([status])
  @@map("queries")
}

model CreditTransaction {
  id               String          @id @default(uuid())
  companyId        String
  type             TransactionType
  amount           Decimal         @db.Decimal(10, 2)
  balance          Decimal         @db.Decimal(10, 2)
  description      String
  relatedQueryId   String?
  createdAt        DateTime        @default(now())

  company          Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([type])
  @@map("credit_transactions")
}

model Payment {
  id             String    @id @default(uuid())
  companyId      String
  orderNsu       String    @unique
  transactionNsu String?
  amount         Decimal   @db.Decimal(10, 2)
  paidAmount     Decimal?  @db.Decimal(10, 2)
  status         String    @default("PENDING") // PENDING, PAID, CANCELLED
  checkoutUrl    String?
  captureMethod  String?   // pix, credit_card
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([orderNsu])
  @@index([status])
  @@map("payments")
}

model Invoice {
  id           String        @id @default(uuid())
  companyId    String
  cycleStart   DateTime
  cycleEnd     DateTime
  dueDate      DateTime
  totalQueries Int           @default(0)
  totalAmount  Decimal       @db.Decimal(10, 2)
  status       InvoiceStatus @default(OPEN)
  checkoutUrl  String?
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([dueDate])
  @@map("invoices")
}

model PricingConfig {
  id                 String   @id @default(uuid())
  defaultQueryPrice  Decimal  @default(5.00) @db.Decimal(10, 2)
  minCreditPurchase  Decimal  @default(50.00) @db.Decimal(10, 2)
  updatedAt          DateTime @updatedAt

  @@map("pricing_configs")
}
