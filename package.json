  "type": "module",
  "description": "Plataforma B2B e API de Histórico Imobiliário e Consultas Cartorárias",
  "scripts": {
    "dev": "vite",
    "dev:server": "cd server && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\" --names \"FRONT,BACK\" --prefix-colors \"cyan,magenta\"",
    "build": "vite build",
    "preview": "vite preview",
    "server:install": "cd server && npm install",
